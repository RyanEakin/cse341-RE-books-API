{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Get all Books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "Books returned successfully"
          },
          "500": {
            "description": "Unable to retrieve books"
          }
        }
      },
      "post": {
        "summary": "Create a book",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bookId",
                  "authorId",
                  "title",
                  "publicationDate"
                ],
                "properties": {
                  "bookId": {
                    "type": "string",
                    "example": "b4"
                  },
                  "authorId": {
                    "type": "string",
                    "example": "a4"
                  },
                  "title": {
                    "type": "string",
                    "example": "test-book"
                  },
                  "publicationDate": {
                    "type": "string",
                    "format": "date",
                    "example": "1990-08-21"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book created successfully"
          },
          "400": {
            "description": "required field is missing"
          },
          "409": {
            "description": "id already exists"
          },
          "500": {
            "description": "Unable to create book"
          }
        }
      }
    },
    "/book/{id}": {
      "get": {
        "summary": "Get one book by id",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom book id, such as b1",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book returned successfully"
          },
          "404": {
            "description": "Book not found"
          },
          "500": {
            "description": "Unable to retrieve book"
          }
        }
      },
      "put": {
        "summary": "Update a book",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "b4"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "authorId": {
                    "type": "string",
                    "example": "a4"
                  },
                  "title": {
                    "type": "string",
                    "example": "test-book"
                  },
                  "publicationDate": {
                    "type": "string",
                    "format": "date",
                    "example": "1995-09-30"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book returned successfully"
          },
          "400": {
            "description": "A required field is missing or invalid"
          },
          "404": {
            "description": "Book not found or authorId does not match an existing author"
          },
          "500": {
            "description": "Unable to update book"
          }
        }
      },
      "delete": {
        "summary": "remove one book by id",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom book id, such as b1",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Book removed successfully"
          },
          "404": {
            "description": "Book not found"
          },
          "500": {
            "description": "Unable to retrieve book"
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}